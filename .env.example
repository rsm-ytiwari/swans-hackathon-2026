# Copy to .env and fill in. Never commit .env.
# Which provider the app uses by default: ollama | gemini | anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:26b
GEMINI_API_KEY=            # aistudio.google.com (free; synthetic data only)
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=         # platform.claude.com -> API keys (paid backup)
ANTHROPIC_MODEL=claude-haiku-4-5
CLOUDFLARE_ACCOUNT_ID=     # optional: Jev / Clef via Workers AI
CLOUDFLARE_API_TOKEN=
TYPESAFE_API_KEY=          # optional: Jev direct
