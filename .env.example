# Copy to .env and fill in. Never commit .env.
# Which provider the app uses by default: claude_cli (local Claude Code login, no key) | anthropic | gemini | ollama
LLM_PROVIDER=claude_cli
LLM_FALLBACK=gemini,ollama
OLLAMA_MODEL=gemma4:26b
GEMINI_API_KEY=            # aistudio.google.com (free; synthetic data only)
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=         # platform.claude.com -> API keys (paid backup)
ANTHROPIC_MODEL=claude-haiku-4-5
CLOUDFLARE_ACCOUNT_ID=     # optional: Jev / Clef via Workers AI
CLOUDFLARE_API_TOKEN=
TYPESAFE_API_KEY=          # optional: Jev direct

# Clio Manage developer app (app.clio.com > Settings > Developer Applications), US region
# Redirect URI: http://127.0.0.1:8765/callback . Read-only permissions only.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# Optional: password for firm pages when the app is reachable publicly (provider /p/ links stay open)
APP_PASSWORD=
